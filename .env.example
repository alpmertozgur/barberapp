# PostgreSQL Configuration (never hardcode credentials in source code)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=barberapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full database connection URL (overrides individual POSTGRES_* vars when set)
DATABASE_URL=postgresql://postgres:change_me_db_password@localhost:5432/barberapp

# Application secrets
ADMIN_DEFAULT_PASSWORD=change_me_admin_password
MASTER_KEY=change_me_master_key
APP_SECRET=change_me_signing_secret

# Server settings
PORT=5000
FLASK_DEBUG=0
